    "/api/v2/Partners": {
      "get": {
        "tags": [
          "Trading Partners"
        ],
        "summary": "Retrieve a list of trading partners. This is a JSON-formatted collection with each object\ncontaining an encoded identifier for a single trading partner. These identifiers are accepted\nby other actions available from /Partners endpoints. If no parameters are passed then all\ntrading partnerships with lead accounts that the user has access to are returned. Parameters\nare used to filter through these trading partnerships.",
        "parameters": [
          {
            "name": "leadAccounts",
            "in": "query",
            "description": "Filter: Accounts the user must have access to.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "leadUserIDs",
            "in": "query",
            "description": "Filter: Mailbox userids that belong to accounts the user has access to.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "followAccounts",
            "in": "query",
            "description": "Filter: Accounts on the other end of the partnerships.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "followUserIDs",
            "in": "query",
            "description": "Filter: Mailbox userids that belong to accounts the user has access to.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Partner"
                  }
                }
              },
              "application/json": {
