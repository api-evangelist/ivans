  "paths": {
    "/api/v2/Files/{id}": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Retrieve a given file",
        "description": "Download a file sent to you using the fileId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The ID of the file to retrieve.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "decompressFile",
            "in": "query",
            "description": "When true file is returned uncompressed if in ZIP or COMMPRESS format, otherwise it will be returned as is",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "description": "Tells the translation service which format to translate to.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation."
          },
          "400": {
            "description": "The request is not formatted properly."
          },
          "401": {
            "description": "User not authorized to view this resource."
          },
          "403": {
            "description": "Forbidden - Requires the following scope: file_transfer",
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer error=\"insufficient_scope\"",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "insufficient_scope"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "File ID was not found."
          },
          "406": {
            "description": "There is an issue with the data provided."
          },
          "409": {
            "description": "Cannot decompress corrupt or incomplete file. Remove [decompressFile] parameter to download original file."
          }
        },
        "security": [
          {}
        ],
        "x-required-scopes": [
          "file_transfer"
        ]
      }
    },
    "/api/v2/Files": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Retrieve a list of all files that match the query string",
        "description": "Retrieve a paginated list of all files that match the query string? criteria provided in the URI using an account-mailboxId pairing. This is a JSON-formatted collection with each object containing detailed information on a single file. Class code may be provided to filter by class code. This endpoint accepts headers used to identify the recipient's Agency Management System, Operating System, and optional information unique to this recipient. Files are retrieved on a page by page basis determined by page and pageSize.",
        "parameters": [
          {
            "name": "account",
            "in": "query",
            "description": "The organization account code of Agency or Carrier. Starting from 'Y...' for agency.",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "userId",
            "in": "query",
            "description": "The ID of the user.",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "classcode",
            "in": "query",
            "description": "The classcode single value can be as: AIDOWN, AIUP, etc. Used as an optional filter.",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "statuscode",
            "in": "query",
            "description": "The type of files received. May be either 'inbox' or 'received'. Defaults to 'inbox' if not used.",
            "schema": {
              "type": "string",
              "default": "inbox"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "The page being requested. If page is not provided, the default is 1.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pagesize",
            "in": "query",
            "description": "The page size, with a lower limit of 25 and an upper limit of 500. If pageSize isn't provided, the default is 25.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 25
            }
          },
          {
            "name": "X-IVANS-Vendor-Company",
            "in": "header",
            "description": "Creator of agency management system",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-IVANS-Vendor-Product",
            "in": "header",
            "description": "Name of agency management system",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-IVANS-Vendor-Version",
            "in": "header",
            "description": "Agency management system version",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-IVANS-Vendor-Customer-Data",
            "in": "header",
            "description": "Caller specific data",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-IVANS-Client-Operating-System",
            "in": "header",
            "description": "Caller operating system",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-IVANS-Client-Instance-Id",
            "in": "header",
            "description": "Guid representing caller. (Note: this GUID must be associated only with this caller and must be the same each time this call is made; it may never change once assigned)",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation.",
            "headers": {
              "First": {
                "description": "Pagination First Page URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "Next": {
                "description": "Pagination Next Page URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "Prev": {
                "description": "Pagination Previous Page URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "Last": {
                "description": "Pagination Last Page URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "Record-Count": {
                "description": "Total Record Count",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FileWithContentTypeAndStatus"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FileWithContentTypeAndStatus"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FileWithContentTypeAndStatus"
                  }
                }
              }
            }
          },
          "204": {
            "description": "No files were found for the given parameters."
          },
          "400": {
            "description": "The request is not formatted properly."
          },
          "401": {
            "description": "User not authorized to view this resource."
          },
          "403": {
            "description": "Forbidden - Requires the following scope: file_transfer",
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer error=\"insufficient_scope\"",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "insufficient_scope"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {}
        ],
        "x-required-scopes": [
          "file_transfer"
        ]
      }
